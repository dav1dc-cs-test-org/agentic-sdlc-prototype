{
  "name": "agentic-sdlc-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.8.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:coverage": "c8 --config .github/sdlc/coverage.json --include 'src/**/*.ts' --check-coverage --lines 80 --branches 70 node --test 'test/**/*.test.ts'",
    "verify": "npm run typecheck && npm run test:coverage && npm run build",
    "workflows:compile": "gh aw compile sdlc-agent"
  },
  "dependencies": {
    "@octokit/rest": "22.0.1",
    "fflate": "0.8.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "c8": "12.0.0",
    "typescript": "7.0.2",
    "yaml": "2.9.0"
  }
}
